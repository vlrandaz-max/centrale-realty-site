# Centrale Realty, Inc. - .htaccess for the static site (Apache / GoDaddy cPanel)
# Upload to public_html/. Keep a copy of the old .htaccess before replacing it.

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Force HTTPS and the non-www host in a single redirect.
#    (Skips /.well-known/ so SSL certificate validation keeps working.)
RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://centralerealty.com%{REQUEST_URI} [R=301,L]

# 2. The Land page is now /properties/. Old addresses redirect permanently (one hop each).
RewriteRule ^for-sale/vacant-land-for-sale/?$ https://centralerealty.com/properties/ [R=301,L]
RewriteRule ^vacant-land/?$ https://centralerealty.com/properties/ [R=301,L]

# 3. Old WordPress endpoints no longer exist: answer "410 Gone".
RewriteRule ^(wp-admin|wp-login\.php|wp-json|wp-content|wp-includes|xmlrpc\.php|feed|comments) - [G,L]
</IfModule>

# Tell browsers to use HTTPS for a year (only after you've confirmed HTTPS works everywhere).
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Friendly 404 page (also used when a request is blocked).
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# Serve index.html for folder URLs (/for-sale/ etc.) and don't list directories.
DirectoryIndex index.html
Options -Indexes

# Compression and browser caching.
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 10 minutes"
ExpiresByType text/css "access plus 1 month"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# Block access to dotfiles (except .well-known) and the repo's source files.
<IfModule mod_rewrite.c>
RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
RewriteRule (^|/)\.(?!well-known) - [F,L]
</IfModule>
